+/* Shader model 2.x/3 has no unbounded loop, so a loop that was not unrolled becomes a "rep" of the
+ * largest count the hardware allows, left through its "break" instructions. The count lives in an
+ * integer constant register that no HLSL variable is allocated to. */
+#define SM1_LOOP_COUNT_REGISTER 15
+#define SM1_LOOP_COUNT_MAX 255
+
+static bool sm1_block_has_loop(const struct hlsl_block *block)
+{
+    const struct hlsl_ir_node *instr;
+
+    LIST_FOR_EACH_ENTRY(instr, &block->instrs, struct hlsl_ir_node, entry)
+    {
+        if (instr->type == HLSL_IR_LOOP)
+            return true;
+        if (instr->type == HLSL_IR_IF)
+        {
+            const struct hlsl_ir_if *iff = hlsl_ir_if(instr);
+
+            if (sm1_block_has_loop(&iff->then_block) || sm1_block_has_loop(&iff->else_block))
+                return true;
+        }
+    }
+
+    return false;
+}
+
+static void sm1_generate_vsir_loop_count_def(struct hlsl_ctx *ctx, struct vsir_program *program,
+        const struct vkd3d_shader_location *loc)
+{
+    struct vkd3d_shader_instruction *ins;
+
+    if (!(ins = generate_vsir_add_program_instruction(ctx, program, loc, VSIR_OP_DEFI, 1, 1)))
+        return;
+
+    vsir_dst_operand_init(&ins->dst[0], VKD3DSPR_CONSTINT, VSIR_DATA_I32, 1);
+    ins->dst[0].reg.dimension = VSIR_DIMENSION_VEC4;
+    ins->dst[0].reg.idx[0].offset = SM1_LOOP_COUNT_REGISTER;
+    ins->dst[0].write_mask = VKD3DSP_WRITEMASK_ALL;
+
+    vsir_src_operand_init(&ins->src[0], VKD3DSPR_IMMCONST, VSIR_DATA_I32, 0);
+    ins->src[0].reg.dimension = VSIR_DIMENSION_VEC4;
+    ins->src[0].reg.u.immconst_u32[0] = SM1_LOOP_COUNT_MAX;
+    ins->src[0].reg.u.immconst_u32[1] = 0;
+    ins->src[0].reg.u.immconst_u32[2] = 1;
+    ins->src[0].reg.u.immconst_u32[3] = 0;
+    ins->src[0].swizzle = VKD3D_SHADER_NO_SWIZZLE;
+}
