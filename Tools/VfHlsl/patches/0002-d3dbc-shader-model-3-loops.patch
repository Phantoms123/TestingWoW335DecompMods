+static void sm1_generate_vsir_instr_loop(struct hlsl_ctx *ctx, struct vsir_program *program, struct hlsl_ir_loop *loop)
+{
+    struct hlsl_ir_node *instr = &loop->node;
+    struct vkd3d_shader_instruction *ins;
+
+    if (!hlsl_version_ge(ctx, 2, 1))
+    {
+        hlsl_fixme(ctx, &instr->loc, "Loops that cannot be unrolled need shader model 2.x or later.");
+        return;
+    }
+
+    if (!(ins = generate_vsir_add_program_instruction(ctx, program, &instr->loc, VSIR_OP_REP, 0, 1)))
+        return;
+
+    vsir_src_operand_init(&ins->src[0], VKD3DSPR_CONSTINT, VSIR_DATA_I32, 1);
+    ins->src[0].reg.dimension = VSIR_DIMENSION_VEC4;
+    ins->src[0].reg.idx[0].offset = SM1_LOOP_COUNT_REGISTER;
+    ins->src[0].swizzle = VKD3D_SHADER_NO_SWIZZLE;
+
+    sm1_generate_vsir_block(ctx, &loop->body, program);
+
+    generate_vsir_add_program_instruction(ctx, program, &instr->loc, VSIR_OP_ENDREP, 0, 0);
+}
